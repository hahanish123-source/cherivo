# Local development does NOT require Supabase. Cherivo stores test greetings in .cherivo-local/.
# Production (Vercel) DOES require these:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Use your final domain, for example:
# NEXT_PUBLIC_SITE_URL=https://cherivo.example
